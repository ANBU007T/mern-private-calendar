# Copy this file to .env and fill in real values before starting the server.

PORT=8080

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/private_calendar

# Must be a long, random string in any real deployment
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_VALUE_1234567890
JWT_EXPIRES_IN=8h

# Used only once, to create the very first admin account when the
# users collection is empty. Change the password immediately after
# your first login.
ADMIN_CODENAME=ADMIN
ADMIN_PASSWORD=ChangeMe123!

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
